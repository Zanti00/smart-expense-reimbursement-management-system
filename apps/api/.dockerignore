# Exclude local secrets and build artifacts from the image
.env
.env.*
!.env.example

# Dependencies are installed at build time from composer.lock
vendor
node_modules

# Runtime writable dirs (recreated by the entrypoint)
storage/logs/*
storage/framework/cache/data/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*

# Tests and VCS bloat
tests
.git
.gitignore

# Stray / non-source artifacts
serms

# Docker build context files (not needed inside the image)
Dockerfile
.dockerignore
