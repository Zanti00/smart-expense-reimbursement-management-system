APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=mysql
DB_PORT=3306
DB_DATABASE=serms
DB_USERNAME=root
DB_PASSWORD=secret

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=redis
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=predis
REDIS_HOST=auth-redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Capstone Auth Module (internal Docker network URL for token verification & profile proxy)
AUTH_SERVICE_URL=http://auth-service:8000
JWT_SECRET=your-shared-secret-key
JWT_PUBLIC_KEY_PATH=storage/oauth-public.key

SUPABASE_STORAGE_DRIVER=s3
SUPABASE_URL=your_supabase_url
SUPABASE_REGION=your_supabase_region
SUPABASE_BUCKET=your_supabase_bucket
SUPABASE_ENDPOINT=your_supabase_endpoint
SUPABASE_ACCESS_KEY_ID=your_supabase_access_key
SUPABASE_SECRET_ACCESS_KEY=your_supabase_secret_key
PRS_REIMBURSEMENT_API_KEY=
PRS_REIMBURSEMENT_STATUS_API_URL=
PRS_REIMBURSEMENT_STATUS_API_KEY=
PRS_REIMBURSEMENT_STATUS_API_TIMEOUT=10

# AI OCR + Categorization Service
# AI_SERVICE_URL: Base URL of the external AI service (e.g., http://ai-service:8000)
# AI_SERVICE_API_KEY: Shared secret the AI service sends as Bearer token in its callback
# AI_SERVICE_TIMEOUT: HTTP timeout (seconds) for the outbound dispatch request
AI_SERVICE_URL=http://ai-service:8000
AI_SERVICE_API_KEY=your_ai_service_api_key
AI_SERVICE_TIMEOUT=10
